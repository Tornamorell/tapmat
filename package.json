{
  "name": "tapmat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:dev": "pglite-server --db=./.pglite --port=5433 --extensions=pg_trgm --max-connections=10",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "seed:user": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "sync:scryfall": "node --env-file-if-exists=.env.local --import tsx scripts/sync-scryfall.ts",
    "sync:names": "node --env-file-if-exists=.env.local --import tsx scripts/sync-names.ts",
    "sql": "node --env-file-if-exists=.env.local --import tsx scripts/sql.ts",
    "snapshot:prices": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-prices.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then npm run db:migrate; fi && next build",
    "sync:pokemon": "node --env-file-if-exists=.env.local --import tsx scripts/sync-pokemon.ts",
    "import:album": "node --env-file-if-exists=.env.local --import tsx scripts/import-album.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/functions": "^3.9.7",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
